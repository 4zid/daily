# Clave de la API de Anthropic para la función "Contale tu día" (IA).
# Sin esta variable la app funciona igual y el chat usa un modo básico sin IA.
ANTHROPIC_API_KEY=

# Opcional: código que hay que ingresar en Ajustes para usar la IA.
# Recomendado si publicás la app, así nadie más usa tu clave.
APP_ACCESS_CODE=
