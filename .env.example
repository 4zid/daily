# Clave de la API de Groq para la función "Contale tu día" (IA). Ver "Activar la IA" en el README.
# Sin esta variable la app funciona igual y el chat usa un modo básico sin IA.
GROQ_API_KEY=
# Otro proveedor compatible con OpenAI (AI_BASE_URL, AI_API_KEY, AI_MODEL): antes de usarlo en
# producción hay que actualizar la política de privacidad, que nombra a Groq como proveedor de la IA.

# Opcional: otro proyecto de Supabase. Sin estas variables se usa el proyecto "daily".
# VITE_SUPABASE_URL=
# VITE_SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_URL=
# SUPABASE_PUBLISHABLE_KEY=
